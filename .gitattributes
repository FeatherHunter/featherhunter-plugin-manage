# Auto detect text files and perform LF normalization
* text=auto

# Keep generated data byte-identical across platforms (build:data --check compares bytes)
*.ts text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.snap text eol=lf
*.py text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
