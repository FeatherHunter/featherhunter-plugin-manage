{
  "name": "dsh-featherhunter-plugin-base",
  "version": "0.0.1",
  "description": "FeatherHunter DSH plugin shared base: settings-panel contact modal / author plugins card widgets and README block renderers",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "readme",
    "contact"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "data",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "default": "./dist/client/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js",
      "default": "./dist/node/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-base": "dist/node/cli.js"
  },
  "peerDependencies": {
    "react": "^18 || ^19"
  },
  "scripts": {
    "build": "node build.mjs",
    "build:demo": "node build.mjs --demo",
    "build:data": "node scripts/run-ts.mjs build-data",
    "data:check": "node scripts/run-ts.mjs build-data --check",
    "contact:update": "node scripts/run-ts.mjs contact-update",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "jpeg-js": "^0.4.4",
    "jsdom": "^30.1.3",
    "pngjs": "^7.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
