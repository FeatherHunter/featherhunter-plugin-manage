// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`author plugin card overrides > locks the card structure and the row order 1`] = `"<div class="dsh-base-plugins"><h3 class="dsh-base-plugins__title"><span class="dsh-base-plugins__title-icon" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="3" width="7" height="7" rx="1"></rect><rect x="14" y="3" width="7" height="7" rx="1"></rect><rect x="3" y="14" width="7" height="7" rx="1"></rect><rect x="14" y="14" width="7" height="7" rx="1"></rect></svg></span><span class="dsh-base-plugins__title-text">作者的其他插件</span></h3><ul class="dsh-base-plugins__list"><li class="dsh-base-plugins__item"><a class="dsh-base-plugins__row" href="https://github.com/FeatherHunter/dsh-mattpocock-skills-deck" target="_blank" rel="noopener noreferrer"><span class="dsh-base-plugins__icon" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="3" width="7" height="7" rx="1"></rect><rect x="14" y="3" width="7" height="7" rx="1"></rect><rect x="3" y="14" width="7" height="7" rx="1"></rect><rect x="14" y="14" width="7" height="7" rx="1"></rect></svg></span><span class="dsh-base-plugins__name">dsh-mattpocock-skills-deck</span><span class="dsh-base-plugins__desc">近 30 万 star 的 mattpocock/skills 整套预置好（27 个技能），装好即用。</span><span class="dsh-base-plugins__ext" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg></span></a></li><li class="dsh-base-plugins__item"><a class="dsh-base-plugins__row" href="https://github.com/FeatherHunter/dsh-prompt" target="_blank" rel="noopener noreferrer"><span class="dsh-base-plugins__icon" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="3" width="7" height="7" rx="1"></rect><rect x="14" y="3" width="7" height="7" rx="1"></rect><rect x="3" y="14" width="7" height="7" rx="1"></rect><rect x="14" y="14" width="7" height="7" rx="1"></rect></svg></span><span class="dsh-base-plugins__name">dsh-prompt</span><span class="dsh-base-plugins__desc">经常反复重复的模板化提示词，存成自定义模板，选中后直接注入，不再需要耗费精力。</span><span class="dsh-base-plugins__ext" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg></span></a></li><li class="dsh-base-plugins__item"><a class="dsh-base-plugins__row" href="https://github.com/FeatherHunter/dsh-opencode-palette" target="_blank" rel="noopener noreferrer"><span class="dsh-base-plugins__icon" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="3" width="7" height="7" rx="1"></rect><rect x="14" y="3" width="7" height="7" rx="1"></rect><rect x="3" y="14" width="7" height="7" rx="1"></rect><rect x="14" y="14" width="7" height="7" rx="1"></rect></svg></span><span class="dsh-base-plugins__name">dsh-opencode-palette</span><span class="dsh-base-plugins__desc">38 款 opencode 经典配色 + 20+自定义主题 一键换装 DSH。</span><span class="dsh-base-plugins__ext" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg></span></a></li><li class="dsh-base-plugins__item"><a class="dsh-base-plugins__row" href="https://github.com/FeatherHunter/dsh-im-companion" target="_blank" rel="noopener noreferrer"><span class="dsh-base-plugins__icon" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="3" width="7" height="7" rx="1"></rect><rect x="14" y="3" width="7" height="7" rx="1"></rect><rect x="3" y="14" width="7" height="7" rx="1"></rect><rect x="14" y="14" width="7" height="7" rx="1"></rect></svg></span><span class="dsh-base-plugins__name">dsh-im-companion</span><span class="dsh-base-plugins__desc">给 dsh-im 加了「助理」和「家」的概念。</span><span class="dsh-base-plugins__ext" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg></span></a></li><li class="dsh-base-plugins__item"><a class="dsh-base-plugins__row" href="https://github.com/FeatherHunter/ilife" target="_blank" rel="noopener noreferrer"><span class="dsh-base-plugins__icon" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="3" width="7" height="7" rx="1"></rect><rect x="14" y="3" width="7" height="7" rx="1"></rect><rect x="3" y="14" width="7" height="7" rx="1"></rect><rect x="14" y="14" width="7" height="7" rx="1"></rect></svg></span><span class="dsh-base-plugins__name">ilife</span><span class="dsh-base-plugins__desc">⚠️建设中⚠️爱生活：居家生活套件，记账、运动、饮食、体重、食谱、物品管理、作息规划、备忘录等。</span><span class="dsh-base-plugins__ext" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg></span></a></li></ul></div>"`;
